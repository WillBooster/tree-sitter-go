{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "go",
      "camelcase": "Go",
      "scope": "source.go",
      "path": ".",
      "file-types": ["go"]
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "MIT",
    "description": "Go grammar for tree-sitter",
    "authors": [
      {
        "name": "WillBooster Inc."
      }
    ],
    "links": {
      "repository": "https://github.com/WillBooster/tree-sitter-go"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
